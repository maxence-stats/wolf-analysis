# OS
Thumbs.db
Desktop.ini
.DS_Store

# Éditeurs
*.swp
*.swp.bak
.idea/

# Outils de dev optionnels (si ajoutés plus tard : lint, serveur local...)
node_modules/
npm-debug.log*

# Fichiers locaux/temporaires
*.local

# fmp-database : données sous licence FMP + éventuelle clé API locale — jamais sur
# le dépôt public. Le code (scripts .py, README, schema.sql) reste suivi normalement.
fmp-database/data/
fmp-database/**/*.env
fmp-database/.env
fmp-database/__pycache__/
# Fichiers de travail générés par resolve_tickers.py/ingest_batch.py — regénérables à
# la demande depuis le Google Sheet + l'API FMP, pas une source de vérité à versionner.
fmp-database/companies*.csv
fmp-database/resolved_tickers*.json
fmp-database/resolved_sector_etfs.json
fmp-database/sheet_logos.json
fmp-database/*log*.txt
__pycache__/
*.pyc

# Échantillons extraits de FMP pour tester Wolf Labo et Documents financiers
# (data/labo-*.json, data/documents-*.json) — même précaution que fmp-database/data/ :
# leurs CGU exigent un accord de licence séparé pour "afficher ou redistribuer" leurs
# données, et ce dépôt est public. Reste en local ; index.html/app.js chargent le
# fichier normalement s'il est présent sur ta machine, l'absence du fichier ne casse
# rien d'autre sur le site (échec géré proprement, tirets affichés).
data/labo-*.json
data/documents-*.json
data/prices-*.json
data/ranking-summary.json
data/logos/
data/logos-manifest.json

# Portefeuille IA (2026-09-19) : données de marché DÉRIVÉES de FMP (mêmes CGU que
# data/prices-*.json) — dividendes/splits, change, indice de référence, métadonnées de
# symboles. Régénérées par fmp-database/export_events.py, export_fx.py,
# export_benchmarks.py, export_symbols_meta.py et refresh_portfolio_ia.py.
data/events-*.json
data/fx-*.json
data/bench-*.json
data/symbols-meta.json
# Sauvegardes horodatées et état du bouton "Actualiser" : locaux, jamais à publier.
# (data/portefeuille-ia/portefeuilles.json, lui, EST versionné — c'est le journal des
# opérations, pas une donnée FMP ; data/ai-logos/ aussi.)
data/portefeuille-ia/backups/
data/portefeuille-ia/refresh-status.json
data/portefeuille-ia/*.tmp

# TradingView (2026-10-27) : données de valorisation issues de l'abonnement TradingView de
# l'utilisateur (licence personnelle, dépôt public => jamais publiées). Le CODE de tv-data/ reste suivi.
data/tv-*.json
tv-data/raw/
tv-data/raw-div/

# Mes portefeuilles (PEA, CTO, Wolf Portfolio) : donnees personnelles, jamais publiees
data/mes-portefeuilles/

# Port reellement utilise par le serveur local (ecrit a chaque lancement)
.claude/server-port.txt

_apercus-partage/
